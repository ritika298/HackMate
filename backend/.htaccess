# Backend hardening (Apache). Config/helpers/middleware have their own deny rules; this covers the rest.
Options -Indexes
<FilesMatch "^(bootstrap\.php|config\.local\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
